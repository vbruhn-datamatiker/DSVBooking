@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">

    <!-- Header -->
    <div class="dsv-header mb-4">
        <h1 class="dsv-title">Privacy Policy</h1>
        <p class="dsv-subtitle">
            How DSV Booking handles your personal data
        </p>
    </div>

    <!-- Intro -->
    <section class="mb-4">
        <p>
            At DSV Booking, we take your privacy seriously. This Privacy Policy explains how we collect,
            use, and protect your personal information when you use our booking platform and related services.
        </p>
        <p>
            We follow applicable data protection laws, including the EU General Data Protection Regulation (GDPR).
        </p>
    </section>

    <!-- Data Collection -->
    <section class="mb-4">
        <h4>1. Information We Collect</h4>
        <ul>
            <li>Contact details (name, email, phone number)</li>
            <li>Booking information (time, date, location, service type)</li>
            <li>System usage data (log files, IP address, device information)</li>
        </ul>
    </section>

    <!-- Purpose -->
    <section class="mb-4">
        <h4>2. How We Use Your Data</h4>
        <ul>
            <li>To manage and confirm bookings</li>
            <li>To improve system performance and user experience</li>
            <li>To communicate important service updates</li>
            <li>To ensure security and prevent misuse</li>
        </ul>
    </section>

    <!-- Legal basis -->
    <section class="mb-4">
        <h4>3. Legal Basis for Processing</h4>
        <p>
            We process your data based on:
        </p>
        <ul>
            <li>Contractual necessity (booking services)</li>
            <li>Legal obligations</li>
            <li>Legitimate interests (system improvement and security)</li>
            <li>Your consent (where applicable)</li>
        </ul>
    </section>

    <!-- Sharing -->
    <section class="mb-4">
        <h4>4. Data Sharing</h4>
        <p>
            We do not sell your personal data. Data may be shared only with:
        </p>
        <ul>
            <li>Internal DSV systems and authorized staff</li>
            <li>IT service providers supporting platform operations</li>
            <li>Legal authorities when required by law</li>
        </ul>
    </section>

    <!-- Storage -->
    <section class="mb-4">
        <h4>5. Data Storage & Security</h4>
        <p>
            Your data is stored securely using industry-standard encryption and access control.
            We retain data only as long as necessary for operational or legal purposes.
        </p>
    </section>

    <!-- Rights -->
    <section class="mb-4">
        <h4>6. Your Rights</h4>
        <ul>
            <li>Access your personal data</li>
            <li>Request correction of inaccurate data</li>
            <li>Request deletion of your data</li>
            <li>Withdraw consent where applicable</li>
            <li>Object to processing in certain cases</li>
        </ul>
    </section>

    <!-- Cookies -->
    <section class="mb-4">
        <h4>7. Cookies</h4>
        <p>
            This platform may use cookies to improve functionality and user experience.
            You can manage cookie preferences in your browser settings.
        </p>
    </section>

    <!-- Contact -->
    <section class="mb-4">
        <h4>8. Contact</h4>
        <p>
            If you have questions regarding this Privacy Policy, please contact:
        </p>

        <div class="card p-3 room-card">
            <strong>DSV Booking Data Protection</strong><br />
            Email: privacy@dsvbooking.local<br />
            Phone: +45 XX XX XX XX
        </div>
    </section>

    <!-- Footer note -->
    <div class="mt-5 text-muted small">
        Last updated: April 2026
    </div>

</div>